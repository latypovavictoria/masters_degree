pipeline {
    agent {
        label 'linux-docker-agent'
    }

    parameters {
        string(name: 'NVD_API_KEY', defaultValue: '', description: 'API KEY for NVD')
        string(name: 'CHECK_JENKINSFILE_PATH', defaultValue: 'Jenkinsfile_ot', description: 'Path to Jenkinsfile for analysis')
    }

    environment {
        JENKINS_URL = 'http://host.docker.internal:8080'
        JENKINS_USER = 'admin'
        JENKINS_TOKEN = credentials('token_admin')
        TRIVY_SEVERITY = 'CRITICAL,HIGH'
    }

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/latypovavictoria/masters_degree.git',
                     branch: 'main'
            }
        }

        stage('Install Python Requirements') {
            steps {
                script {
                    if (isUnix()) {
                        sh '''
                            python3 -m pip install --upgrade pip
                            pip3 install requests
                        '''
                    } else {
                        bat '''
                            python -m pip install --upgrade pip
                            pip install requests
                        '''
                    }
                }
            }
        }

        stage('Dependency Scan') {
            steps {
                dependencyCheck additionalArguments: """
                    --scan ./src
                    --format JSON
                    --nvdApiKey $NVD_API_KEY
                    --failOnCVSS 7
                """, odcInstallation: 'OWASP-DC'

                dependencyCheckPublisher pattern: 'dependency-check-report.json'
            }
        }

        stage('Run Security Check') {
            steps {
                script {
                    if (isUnix()) {
                        sh '''
                            python3 security_check.py "$JENKINS_URL" "$JENKINS_USER" "$JENKINS_TOKEN"
                        '''
                    } else {
                        bat '''
                            python security_check.py "%JENKINS_URL%" "%JENKINS_USER%" "%JENKINS_TOKEN%"
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Security scan completed. See reports for details.'
        }
        failure {
            slackSend channel: '#security-alerts',
                     message: "Security check failed in ${env.JOB_NAME} (${env.BUILD_URL})"
        }
    }
}